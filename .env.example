# Notion Internal Integration 토큰 (https://www.notion.so/my-integrations 에서 발급)
NOTION_API_KEY=your_notion_integration_token_here

# Claude API 키 (https://console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# "수업 자료" 데이터소스(데이터베이스) ID — FILTER 유형(학년/과목/날짜) 검색에 필요.
# notion-mcp-server의 search 또는 retrieve-a-database tool로 한 번 조회해서 채워넣기.
NOTION_DATA_SOURCE_ID=
