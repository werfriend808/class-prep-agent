# Notion Internal Integration 토큰 (https://www.notion.so/my-integrations 에서 발급)
NOTION_API_KEY=your_notion_integration_token_here

# Claude API 키 (https://console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# "수업 자료" 데이터소스(데이터베이스) ID — FILTER 유형(학년/과목/날짜) 검색에 필요.
# notion-mcp-server의 search 또는 retrieve-a-database tool로 한 번 조회해서 채워넣기.
NOTION_DATA_SOURCE_ID=

# 실전 프로젝트 2: 생성된 수업계획안 페이지를 만들어 넣을 부모 Notion 페이지 ID.
# 해당 페이지에 Integration을 Connections로 연결해두어야 한다.
NOTION_LESSON_PLAN_PARENT_ID=

# 프로젝트 전체(실전 1 요약/질의분류 + 실전 2 계획안 생성)에서 쓰는 LLM provider 선택.
# 비워두거나 "anthropic"이면 위 ANTHROPIC_API_KEY로 Claude를 쓴다.
# "clova"로 설정하면 아래 HCX_API_KEY로 네이버 클로바 스튜디오를 쓴다.
LLM_PROVIDER=

# 네이버 클로바 스튜디오(HyperCLOVA X) API 키. LLM_PROVIDER=clova일 때만 필요.
HCX_API_KEY=
# 클로바 스튜디오에서 쓸 모델명 (기본값 HCX-005).
HCX_MODEL=
