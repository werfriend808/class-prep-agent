# Streamlit Community Cloud → App settings → Secrets 에 붙여넣을 템플릿.
# 실제 값이 들어간 .streamlit/secrets.toml 은 .gitignore 되어 있다.
# 최상위 키들은 config.py의 _setting()이 env -> st.secrets 순으로 읽는다.

# --- 앱 동작 ---
LOCALE = "us"          # 영어 UI + Common Core Math
DEMO_MODE = "1"        # Notion/Google 쓰기 끄기 (공개 배포 필수)

# --- LLM ---
LLM_PROVIDER = "anthropic"
ANTHROPIC_API_KEY = "sk-ant-..."
CLAUDE_MODEL = "claude-haiku-5-5"
CLAUDE_THINKING = "disabled"   # Haiku 5.5: thinking이 max_tokens를 다 쓰는 문제 방지

# --- 비용 상한 (LLM 호출 수 기준, 0 = 무제한) ---
DAILY_LLM_CALL_LIMIT = "150"
SESSION_LLM_CALL_LIMIT = "30"

# --- 익명 사용 지표 (docs/deploy.md 의 SQL로 테이블 생성) ---
SUPABASE_URL = "https://<project-ref>.supabase.co"
SUPABASE_KEY = "sb_secret_..."

# --- 피드백 폼 ---
FEEDBACK_URL = "https://forms.gle/..."
